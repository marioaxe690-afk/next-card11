# ===========================================
# Next Card 环境变量示例
# 复制这个文件为 .env.local 后填入真实值
# 不配置任何 key 也能跑 — 自动 fallback 到本地 mock
# ===========================================

# --- AI Provider (二选一,或全不配走本地 mock) ---

# DeepSeek (推荐,价格便宜,中文好)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Mimo (作为 DeepSeek 失败时的备份)
MIMO_API_KEY=
MIMO_BASE_URL=
MIMO_MODEL=

# Provider 选择: deepseek | mimo (默认 mimo,会按 cascade 顺序 fallback)
NEXT_CARD_CHAT_PROVIDER=deepseek

# --- Web Push (可选) ---
# 用 web-push CLI 生成: npx web-push generate-vapid-keys
NEXT_CARD_PUSH_VAPID_SUBJECT=
NEXT_CARD_PUSH_VAPID_PUBLIC_KEY=
NEXT_CARD_PUSH_VAPID_PRIVATE_KEY=
NEXT_CARD_PUSH_TTL_SECONDS=3600

# --- ICS 日历导出 (可选) ---
NEXT_CARD_CALENDAR_NAME=Next Card
NEXT_CARD_CALENDAR_PRODUCT_ID=-//Next Card//EN
NEXT_CARD_CALENDAR_DEFAULT_DURATION_MINUTES=25

# --- 其他 ---
# 部署后填线上 URL,Web Push 通知点击会跳转到这
NEXT_PUBLIC_APP_URL=
